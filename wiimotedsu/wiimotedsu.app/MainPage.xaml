<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="wiimotedsu.app.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Spacing="25"
            Padding="30,0"
            VerticalOptions="Center">

            <Label 
                Text="Wiimote DSU Server"
                SemanticProperties.HeadingLevel="Level1"
                FontSize="32"
                HorizontalOptions="Center" />

            <Label
                x:Name="IpLabel"
                Text="Detecting IP..."
                FontSize="18"
                HorizontalOptions="Center" />

            <Button
                x:Name="ServerBtn"
                Text="Launch Server"
                SemanticProperties.Hint="Starts/Stops the server"
                HorizontalOptions="Center" />
                <!--Clicked="OnServerBtnClicked"-->
            
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
